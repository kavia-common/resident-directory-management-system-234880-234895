# PostgreSQL connection URL (provided by platform / database container)
# IMPORTANT: In this project, database_postgresql/db_connection.txt uses port 5000 by default.
POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# JWT signing secret (set a strong random value)
JWT_SECRET=change-me-super-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Policy
REQUIRE_ADMIN_APPROVAL=true

# OTP settings
OTP_TTL_SECONDS=600
# Development only - if true, /auth/otp/request returns otp in response
OTP_TEST_BYPASS=false

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HEADERS=Content-Type,Authorization
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
